# Application Environment
NODE_ENV=production
PORT=3000

# Firebase Configuration (Optional - for stats/analytics)
# Get your service account JSON from Firebase Console
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Rollbar Error Tracking (Optional)
# ROLLBAR_POST_SERVER_ITEM_ACCESS_TOKEN=your_server_token
# ROLLBAR_POST_CLIENT_ITEM_ACCESS_TOKEN=your_client_token

# Note: Firebase and Rollbar are optional. The app will work without them.
# Firebase is used for global stats tracking.
# Rollbar is used for error reporting.