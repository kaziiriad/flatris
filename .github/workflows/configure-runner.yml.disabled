name: Configure Self-Hosted Runner

on:
  workflow_dispatch:

jobs:
  configure-runner:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        run: |
          mkdir -p ~/.aws
          echo "[default]" > ~/.aws/credentials
          echo "aws_access_key_id = ${{ secrets.AWS_ACCESS_KEY_ID }}" >> ~/.aws/credentials
          echo "aws_secret_access_key = ${{ secrets.AWS_SECRET_ACCESS_KEY }}" >> ~/.aws/credentials
          echo "[default]" > ~/.aws/config
          echo "region = ap-southeast-1" >> ~/.aws/config
          chmod 600 ~/.aws/credentials ~/.aws/config

      - name: Setup SSH key
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.SSH_PRIVATE_KEY }}" > ~/.ssh/flatris-keypair.pem
          chmod 400 ~/.ssh/flatris-keypair.pem
          ssh-keygen -y -f ~/.ssh/flatris-keypair.pem > ~/.ssh/flatris-keypair.pem.pub

      - name: Setup Pulumi
        run: |
          curl -fsSL https://get.pulumi.com | sh
          echo "$PATH" >> $GITHUB_PATH

      - name: Setup uv
        run: |
          curl -LsSf https://astral.sh/uv/install.sh | sh
          echo "$HOME/.cargo/bin" >> $GITHUB_PATH

      - name: Pulumi login
        env:
          PULUMI_ACCESS_TOKEN: ${{ secrets.PULUMI_ACCESS_TOKEN }}
        run: pulumi login

      - name: Select Pulumi stack
        run: |
          cd infra
          pulumi stack select flatris-dev

      - name: Get Runner IP from Pulumi
        id: pulumi-outputs
        run: |
          cd infra
          uv sync
          RUNNER_IP=$(pulumi stack output runner_public_ip)
          echo "runner_ip=$RUNNER_IP" >> $GITHUB_OUTPUT
          echo "Runner IP: $RUNNER_IP"

      - name: Wait for runner to be ready
        run: |
          RUNNER_IP="${{ steps.pulumi-outputs.outputs.runner_ip }}"
          echo "Waiting for runner at $RUNNER_IP to be ready..."

          for i in {1..30}; do
            if ssh -i ~/.ssh/flatris-keypair.pem -o StrictHostKeyChecking=no -o ConnectTimeout=5 ubuntu@$RUNNER_IP "echo ready" 2>/dev/null; then
              echo "Runner is ready!"
              break
            fi
            echo "Attempt $i: Runner not ready yet, waiting 10 seconds..."
            sleep 10
          done

      - name: SSH into Runner EC2 and install Git Runner
        run: |
          ssh -i ~/.ssh/flatris-keypair.pem -o StrictHostKeyChecking=no ubuntu@${{ steps.pulumi-outputs.outputs.runner_ip }} << EOF
            set -e

            if [ -d "/home/ubuntu/actions-runner" ]; then
              cd /home/ubuntu/actions-runner
              sudo ./svc.sh stop || true
              sudo ./svc.sh uninstall || true
              cd /home/ubuntu
              sudo rm -rf actions-runner
            fi

            mkdir actions-runner && cd actions-runner

            curl -o actions-runner-linux-x64-2.331.0.tar.gz -L https://github.com/actions/runner/releases/download/v2.331.0/actions-runner-linux-x64-2.331.0.tar.gz

            echo "5fcc01bd546ba5c3f1291c2803658ebd3cedb3836489eda3be357d41bfcf28a7  actions-runner-linux-x64-2.331.0.tar.gz" | shasum -a 256 -c

            tar xzf ./actions-runner-linux-x64-2.331.0.tar.gz
            rm -f actions-runner-linux-x64-2.331.0.tar.gz

            ./config.sh \
              --unattended \
              --url https://github.com/kaziiriad/flatris \
              --token ${{ secrets.RUNNER_TOKEN }} \
              --name flatris

            ./run.sh

          EOF

